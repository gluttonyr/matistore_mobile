{
  "expo": {
    "name": "matistore",
    "slug": "matistore",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-ios.png",
    "scheme": "matistoremobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/logo-ios.png",
      "bundleIdentifier": "com.urbain-diligence.matistore-mobile",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.urbain_diligence.matistore_mobile",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/logo-ios.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CALL_PHONE",
        "android.permission.READ_PHONE_STATE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logo-ios.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
